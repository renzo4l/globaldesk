# ==============================================================================
# GLOBAL DESK API — EXEMPLO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================

# String de conexão do PostgreSQL local no servidor
DATABASE_URL="postgresql://postgres:SUA_SENHA_POSTGRES_AQUI@localhost:5432/globaldesk?schema=public"

# Porta interna da API Node.js (acessada via Proxy Reverso ARR do IIS em localhost:3001)
PORT=3001
NODE_ENV=production

# Domínio interno/corporativo configurado no DNS e no IIS
FRONTEND_URL="http://chamados.suaempresa.com.br"

# Controle explícito da flag Secure do Cookie HttpOnly:
# Mantenha "false" enquanto operar em HTTP na rede interna; mude para "true" se ativar HTTPS/SSL
COOKIE_SECURE="false"

# Chave secreta para assinatura dos tokens JWT (Cookie HttpOnly)
JWT_SECRET="INSIRA_SUA_CHAVE_JWT_SECRETA_AQUI_MIN_32_CHARS"

# Credenciais Google Workspace OAuth 2.0
GOOGLE_CLIENT_ID="SEU_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="SEU_GOOGLE_CLIENT_SECRET_AQUI"
WORKSPACE_DOMAIN="suaempresa.com.br"

# Conta Superadmin inicial para o seed do banco
SUPERADMIN_NAME="Administrador de TI"
SUPERADMIN_EMAIL="admin@suaempresa.com.br"
